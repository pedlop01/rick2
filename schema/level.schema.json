{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rick2.example/schema/level.schema.json",
  "title": "Rick2 canonical level package",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "units", "display", "camera", "map", "entities", "player", "projectiles", "definitions", "audio"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "rick2.level" },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulationTicksPerSecond", "duration", "distance", "speed"],
      "properties": {
        "simulationTicksPerSecond": { "const": 50 },
        "duration": { "const": "ticks" },
        "distance": { "const": "pixels" },
        "speed": { "const": "pixelsPerTick" }
      }
    },
    "display": { "$ref": "#/$defs/viewport" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialLives"],
      "properties": { "initialLives": { "$ref": "#/$defs/positiveInteger" } }
    },
    "runtimeProfile": { "$ref": "#/$defs/runtimeProfile" },
    "gameplay": { "$ref": "#/$defs/gameplayProgram" },
    "objective": { "$ref": "#/$defs/objective" },
    "camera": {
      "allOf": [
        { "$ref": "#/$defs/viewport" },
        {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "map": { "$ref": "#/$defs/map" },
    "entities": { "$ref": "#/$defs/entities" },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition"],
      "properties": { "definition": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "projectiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shoot", "bomb"],
      "properties": {
        "shoot": { "$ref": "#/$defs/projectile" },
        "bomb": { "$ref": "#/$defs/projectile" }
      }
    },
    "definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/animationDefinition" }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialMusic", "music", "effects"],
      "properties": {
        "initialMusic": { "type": "integer", "minimum": 0 },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialLoop", "followUpMusic", "followUpLoop"],
          "properties": {
            "initialLoop": { "type": "boolean" },
            "followUpMusic": { "type": ["integer", "null"], "minimum": 0 },
            "followUpLoop": { "type": "boolean" }
          }
        },
        "music": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nullableAudioSlot": { "type": ["integer", "null"], "minimum": 0 },
    "gameplayProgram": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "flags": { "type": "array", "items": { "$ref": "#/$defs/gameplayFlag" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/gameplayEvent" } },
        "sequences": { "type": "array", "items": { "$ref": "#/$defs/gameplaySequence" } }
      }
    },
    "gameplayFlag": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "initial"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "boolean" }, "initial": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "initial"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "number" }, "initial": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "initial"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "string" }, "initial": { "type": "string" } } }
      ]
    },
    "gameplayEvent": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "description": { "type": "string" } } },
    "gameplayCondition": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "event" }, "event": { "$ref": "#/$defs/nonEmptyString" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "flag", "comparison", "value"], "properties": { "type": { "const": "flag" }, "flag": { "$ref": "#/$defs/nonEmptyString" }, "comparison": { "enum": ["equal", "notEqual", "greater", "greaterOrEqual", "lower", "lowerOrEqual"] }, "value": { "type": ["boolean", "number", "string"] } } }
    ] },
    "gameplayAction": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "flag", "value"], "properties": { "type": { "const": "setFlag" }, "flag": { "$ref": "#/$defs/nonEmptyString" }, "value": { "type": ["boolean", "number", "string"] } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "flag"], "properties": { "type": { "const": "toggleFlag" }, "flag": { "$ref": "#/$defs/nonEmptyString" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "flag", "amount"], "properties": { "type": { "const": "incrementFlag" }, "flag": { "$ref": "#/$defs/nonEmptyString" }, "amount": { "type": "number" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "emitEvent" }, "event": { "$ref": "#/$defs/nonEmptyString" } } }
    ] },
    "gameplayStep": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "action"], "properties": { "type": { "const": "action" }, "action": { "$ref": "#/$defs/gameplayAction" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "ticks"], "properties": { "type": { "const": "wait" }, "ticks": { "$ref": "#/$defs/positiveInteger" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "steps"], "properties": { "type": { "enum": ["serial", "parallel"] }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gameplayStep" } } } }
    ] },
    "gameplaySequence": { "type": "object", "additionalProperties": false, "required": ["id", "steps"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gameplayStep" } } } },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spriteWidth": { "$ref": "#/$defs/positiveInteger" },
            "collisionWidth": { "$ref": "#/$defs/positiveInteger" },
            "standingHeight": { "$ref": "#/$defs/positiveInteger" },
            "crouchingHeight": { "$ref": "#/$defs/positiveInteger" },
            "collisionOffsetX": { "type": "number", "minimum": 0 },
            "runSpeed": { "type": "number", "minimum": 0 },
            "minimumVerticalSpeed": { "type": "number", "exclusiveMinimum": 0 },
            "maximumVerticalSpeed": { "type": "number", "exclusiveMinimum": 0 },
            "verticalAcceleration": { "type": "number", "exclusiveMinimum": 0 },
            "climbSpeed": { "type": "number", "minimum": 0 },
            "jumpHeight": { "type": "number", "minimum": 0 },
            "deathRise": { "type": "number", "minimum": 0 },
            "deathSpeedMultiplier": { "type": "number", "exclusiveMinimum": 0 },
            "deathRespawnTicks": { "$ref": "#/$defs/positiveInteger" },
            "hitHoldTicks": { "type": "number", "minimum": 0 }
          }
        },
        "capabilities": {
          "type": "object", "additionalProperties": false,
          "properties": { "jump": { "type": "boolean" }, "crouch": { "type": "boolean" }, "climb": { "type": "boolean" }, "shoot": { "type": "boolean" }, "bomb": { "type": "boolean" }, "hit": { "type": "boolean" } }
        },
        "actionBindings": {
          "type": "object", "additionalProperties": false,
          "properties": { "up": { "$ref": "#/$defs/playerAction" }, "down": { "$ref": "#/$defs/playerAction" }, "horizontal": { "$ref": "#/$defs/playerAction" } }
        },
        "characterForms": { "$ref": "#/$defs/characterForms" },
        "session": {
          "type": "object", "additionalProperties": false,
          "properties": { "initialLives": { "$ref": "#/$defs/positiveInteger" }, "damageEnabled": { "type": "boolean" }, "respawn": { "enum": ["checkpoint", "none"] }, "resetTriggersOnDeath": { "type": "boolean" }, "deathAudioSlot": { "$ref": "#/$defs/nullableAudioSlot" } }
        },
        "bindings": { "$ref": "#/$defs/runtimeBindings" }
      }
    },
    "characterForms": {
      "type": "object", "additionalProperties": false,
      "required": ["initialForm", "forms"],
      "properties": {
        "initialForm": { "$ref": "#/$defs/nonEmptyString" },
        "forms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/characterForm" } }
      }
    },
    "characterForm": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stateMachine"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "definition": { "$ref": "#/$defs/nonEmptyString" },
        "controller": { "$ref": "#/$defs/runtimeProfile/properties/controller" },
        "capabilities": { "$ref": "#/$defs/runtimeProfile/properties/capabilities" },
        "actionBindings": { "$ref": "#/$defs/runtimeProfile/properties/actionBindings" },
        "stateMachine": { "$ref": "#/$defs/characterStateMachine" }
      }
    },
    "characterStateMachine": {
      "type": "object", "additionalProperties": false,
      "required": ["initialState", "states"],
      "properties": {
        "initialState": { "$ref": "#/$defs/nonEmptyString" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/characterState" } }
      }
    },
    "characterState": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "behavior": { "enum": ["stop", "running", "jumping", "crouching", "climbing", "shooting", "bombing", "hitting", "dead"] },
        "animation": { "$ref": "#/$defs/nonEmptyString" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/characterTransition" } }
      }
    },
    "characterTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["to", "conditions"],
      "properties": {
        "to": { "$ref": "#/$defs/nonEmptyString" },
        "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/characterCondition" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/characterAction" } }
      }
    },
    "characterCondition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "control", "pressed"], "properties": { "type": { "const": "control" }, "control": { "enum": ["left", "right", "up", "down", "action"] }, "pressed": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "action", "active"], "properties": { "type": { "const": "action" }, "action": { "$ref": "#/$defs/nonEmptyString" }, "active": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "event" }, "event": { "$ref": "#/$defs/nonEmptyString" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "signal", "value"], "properties": { "type": { "const": "signal" }, "signal": { "enum": ["grounded", "onStairs", "canDescendStairs", "canStand", "ceilingBlocked"] }, "value": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "comparison", "value"], "properties": { "type": { "const": "elapsedTicks" }, "comparison": { "$ref": "#/$defs/comparison" }, "value": { "type": "number", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "axis", "comparison", "value"], "properties": { "type": { "const": "distance" }, "axis": { "enum": ["x", "y"] }, "comparison": { "$ref": "#/$defs/comparison" }, "value": { "type": "number", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "comparison", "state"], "properties": { "type": { "const": "previousState" }, "comparison": { "enum": ["equal", "notEqual"] }, "state": { "$ref": "#/$defs/nonEmptyString" } } }
      ]
    },
    "characterAction": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "setFacing" }, "value": { "enum": ["left", "right", "input"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "axis"], "properties": { "type": { "const": "capturePosition" }, "axis": { "enum": ["x", "y", "both"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "form"], "properties": { "type": { "const": "setForm" }, "form": { "$ref": "#/$defs/nonEmptyString" } } }
      ]
    },
    "comparison": { "enum": ["equal", "notEqual", "greater", "greaterOrEqual", "lower", "lowerOrEqual"] },
    "playerAction": { "enum": ["shooting", "bombing", "hitting", null] },
    "runtimeBindings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "playerStates": { "type": "object", "additionalProperties": false, "properties": { "stop": { "$ref": "#/$defs/nonEmptyString" }, "running": { "$ref": "#/$defs/nonEmptyString" }, "jumping": { "$ref": "#/$defs/nonEmptyString" }, "crouching": { "$ref": "#/$defs/nonEmptyString" }, "climbing": { "$ref": "#/$defs/nonEmptyString" }, "shooting": { "$ref": "#/$defs/nonEmptyString" }, "bombing": { "$ref": "#/$defs/nonEmptyString" }, "hitting": { "$ref": "#/$defs/nonEmptyString" }, "dead": { "$ref": "#/$defs/nonEmptyString" } } },
        "enemyStates": { "type": "object", "additionalProperties": false, "properties": { "running": { "$ref": "#/$defs/nonEmptyString" }, "climbing": { "$ref": "#/$defs/nonEmptyString" }, "dying": { "$ref": "#/$defs/nonEmptyString" } } },
        "objectStates": { "type": "object", "additionalProperties": false, "properties": { "stop": { "$ref": "#/$defs/nonEmptyString" }, "moving": { "$ref": "#/$defs/nonEmptyString" }, "dying": { "$ref": "#/$defs/nonEmptyString" } } },
        "audio": { "type": "object", "additionalProperties": false, "properties": { "shot": { "$ref": "#/$defs/nullableAudioSlot" }, "bomb": { "$ref": "#/$defs/nullableAudioSlot" }, "explosion": { "$ref": "#/$defs/nullableAudioSlot" }, "bonusPickup": { "$ref": "#/$defs/nullableAudioSlot" }, "itemPickup": { "$ref": "#/$defs/nullableAudioSlot" } } }
      }
    },
    "objective": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "none" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "width", "height", "onComplete"],
          "properties": {
            "type": { "const": "reachZone" },
            "x": { "type": "integer" }, "y": { "type": "integer" },
            "width": { "$ref": "#/$defs/positiveInteger" },
            "height": { "$ref": "#/$defs/positiveInteger" },
            "onComplete": { "enum": ["continue", "freeze"] }
          }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "projectile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "width", "height", "yOffset"],
      "properties": {
        "definition": { "$ref": "#/$defs/nonEmptyString" },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "yOffset": { "type": "integer" },
        "boundingBox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "$ref": "#/$defs/positiveInteger" },
            "height": { "$ref": "#/$defs/positiveInteger" }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tileWidth", "tileHeight", "tileset", "layers"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "tileWidth": { "$ref": "#/$defs/positiveInteger" },
        "tileHeight": { "$ref": "#/$defs/positiveInteger" },
        "tileset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "tileCount", "columns", "imageWidth", "imageHeight"],
          "properties": {
            "image": { "$ref": "#/$defs/nonEmptyString" },
            "tileCount": { "$ref": "#/$defs/positiveInteger" },
            "columns": { "$ref": "#/$defs/positiveInteger" },
            "imageWidth": { "$ref": "#/$defs/positiveInteger" },
            "imageHeight": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles", "frontTiles", "collisions"],
          "properties": {
            "tiles": { "$ref": "#/$defs/tileLayer" },
            "frontTiles": { "$ref": "#/$defs/tileLayer" },
            "collisions": { "$ref": "#/$defs/tileLayer" }
          }
        }
      }
    },
    "tileLayer": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "items", "backgroundObjects", "blocks", "hazards", "checkpoints", "lasers", "triggers", "enemies", "cameraViews"],
      "properties": {
        "platforms": { "$ref": "#/$defs/platformArray" },
        "items": { "$ref": "#/$defs/itemArray" },
        "backgroundObjects": { "$ref": "#/$defs/backgroundObjectArray" },
        "blocks": { "$ref": "#/$defs/blockArray" },
        "hazards": { "$ref": "#/$defs/hazardArray" },
        "checkpoints": { "$ref": "#/$defs/checkpointArray" },
        "lasers": { "$ref": "#/$defs/laserArray" },
        "triggers": { "$ref": "#/$defs/triggerArray" },
        "enemies": { "$ref": "#/$defs/enemyArray" },
        "cameraViews": { "$ref": "#/$defs/cameraViewArray" }
      }
    },
    "booleanInteger": { "type": "integer", "enum": [0, 1] },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "number": { "type": "number" },
    "definitionReference": { "$ref": "#/$defs/nonEmptyString" },
    "placementAttributes": {
      "type": "object",
      "required": ["ini_x", "ini_y", "width", "height", "definition"],
      "properties": {
        "ini_x": { "type": "integer" },
        "ini_y": { "type": "integer" },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "definition": { "$ref": "#/$defs/definitionReference" }
      }
    },
    "movementAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "desp", "wait", "speed", "cond"],
      "properties": {
        "direction": { "enum": ["stop", "right", "left", "up", "down"] },
        "desp": { "$ref": "#/$defs/nonNegativeInteger" },
        "wait": { "$ref": "#/$defs/nonNegativeInteger" },
        "speed": { "type": "number", "minimum": 0 },
        "cond": { "type": "integer", "enum": [0, 1, 2] }
      }
    },
    "hazardAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "desp", "wait", "speed", "cond"],
      "properties": {
        "direction": { "enum": ["stop", "right", "left", "up", "down", "deactivate"] },
        "desp": { "$ref": "#/$defs/nonNegativeInteger" },
        "wait": { "$ref": "#/$defs/nonNegativeInteger" },
        "speed": { "type": "number", "minimum": 0 },
        "cond": { "type": "integer", "enum": [0, 1, 2] }
      }
    },
    "actionCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/movementAction" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/movementAction" } }
          ]
        }
      }
    },
    "hazardActionCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/hazardAction" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hazardAction" } }
          ]
        }
      }
    },
    "platformArray": { "type": "array", "items": { "$ref": "#/$defs/platform" } },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attributes", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/placementAttributes" },
            {
              "type": "object",
              "required": ["visible", "recursive", "one_use", "ini_state"],
              "properties": {
                "visible": { "$ref": "#/$defs/booleanInteger" },
                "recursive": { "$ref": "#/$defs/booleanInteger" },
                "one_use": { "$ref": "#/$defs/booleanInteger" },
                "ini_state": { "enum": ["stop", "moving"] }
              }
            }
          ]
        },
        "actions": { "$ref": "#/$defs/actionCollection" }
      }
    },
    "itemArray": { "type": "array", "items": { "$ref": "#/$defs/simplePlacedEntity" } },
    "simplePlacedEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "allOf": [{ "$ref": "#/$defs/placementAttributes" }],
          "unevaluatedProperties": false
        }
      }
    },
    "backgroundObjectArray": { "type": "array", "items": { "$ref": "#/$defs/backgroundObject" } },
    "backgroundObject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/placementAttributes" },
            { "type": "object", "required": ["skip_num_anims"], "properties": { "skip_num_anims": { "$ref": "#/$defs/nonNegativeInteger" } } }
          ]
        }
      }
    },
    "blockArray": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/placementAttributes" },
            { "type": "object", "required": ["exploits"], "properties": { "exploits": { "$ref": "#/$defs/booleanInteger" } } }
          ]
        }
      }
    },
    "hazardArray": { "type": "array", "items": { "$ref": "#/$defs/hazard" } },
    "hazard": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attributes", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/placementAttributes" },
            { "type": "object", "required": ["trigger", "stop_inactive"], "properties": {
              "trigger": { "$ref": "#/$defs/booleanInteger" },
              "stop_inactive": { "$ref": "#/$defs/booleanInteger" }
            } }
          ]
        },
        "actions": { "$ref": "#/$defs/hazardActionCollection" }
      }
    },
    "checkpointArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkpoint" } },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "chk_x", "chk_y", "chk_width", "chk_height", "pl_x", "pl_y", "pl_face", "nxt_chks"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "chk_x": { "type": "integer" }, "chk_y": { "type": "integer" },
        "chk_width": { "$ref": "#/$defs/positiveInteger" }, "chk_height": { "$ref": "#/$defs/positiveInteger" },
        "pl_x": { "type": "integer" }, "pl_y": { "type": "integer" },
        "pl_face": { "enum": ["left", "right"] },
        "nxt_chks": { "type": "array", "items": { "$ref": "#/$defs/nonNegativeInteger" }, "uniqueItems": true }
      }
    },
    "laserArray": { "type": "array", "items": { "$ref": "#/$defs/laser" } },
    "laser": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y", "bb_x", "bb_y", "bb_width", "bb_height", "type", "speed", "recursive", "direction", "default_trigger", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" }, "x": { "type": "integer" }, "y": { "type": "integer" },
        "bb_x": { "$ref": "#/$defs/nonNegativeInteger" }, "bb_y": { "$ref": "#/$defs/nonNegativeInteger" },
        "bb_width": { "$ref": "#/$defs/positiveInteger" }, "bb_height": { "$ref": "#/$defs/positiveInteger" },
        "type": { "enum": ["horizontal", "vertical", "diagonal"] },
        "speed": { "type": "number", "minimum": 0 }, "recursive": { "$ref": "#/$defs/booleanInteger" },
        "direction": { "enum": ["left", "right"] }, "default_trigger": { "$ref": "#/$defs/booleanInteger" },
        "definition": { "$ref": "#/$defs/definitionReference" }
      }
    },
    "triggerArray": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
    "triggerTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "id", "delay", "trigger", "trigger_cond"],
      "properties": {
        "type": { "enum": ["platform", "laser", "hazard"] },
        "id": { "$ref": "#/$defs/nonNegativeInteger" }, "delay": { "$ref": "#/$defs/nonNegativeInteger" },
        "trigger": { "$ref": "#/$defs/booleanInteger" }, "trigger_cond": { "$ref": "#/$defs/booleanInteger" }
      }
    },
    "triggerTargets": {
      "type": "object", "additionalProperties": false, "required": ["target"],
      "properties": { "target": { "oneOf": [
        { "$ref": "#/$defs/triggerTarget" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/triggerTarget" } }
      ] } }
    },
    "trigger": {
      "type": "object", "additionalProperties": false, "required": ["id", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "attributes": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "width", "height", "recursive", "onehot", "action", "face"],
          "properties": {
            "x": { "type": "integer" }, "y": { "type": "integer" },
            "width": { "$ref": "#/$defs/positiveInteger" }, "height": { "$ref": "#/$defs/positiveInteger" },
            "recursive": { "$ref": "#/$defs/booleanInteger" }, "onehot": { "$ref": "#/$defs/booleanInteger" },
            "action": { "enum": ["enters", "stays", "exits", "hits"] }, "face": { "enum": ["any", "left", "right"] }
          }
        },
        "targets": { "$ref": "#/$defs/triggerTargets" },
        "gameplay": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/gameplayCondition" } },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/gameplayAction" } },
            "sequence": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "enemyArray": { "type": "array", "items": { "$ref": "#/$defs/enemy" } },
    "enemy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y", "bb_x", "bb_y", "bb_width", "bb_height", "direction", "speed_x", "speed_y", "ia_type", "ia_random", "ia_randomness", "ia_block_steps", "ia_orig_x", "ia_orig_y", "ia_limit_x", "ia_limit_y", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" }, "x": { "type": "integer" }, "y": { "type": "integer" },
        "bb_x": { "$ref": "#/$defs/nonNegativeInteger" }, "bb_y": { "$ref": "#/$defs/nonNegativeInteger" },
        "bb_width": { "$ref": "#/$defs/positiveInteger" }, "bb_height": { "$ref": "#/$defs/positiveInteger" },
        "direction": { "enum": ["left", "right"] },
        "speed_x": { "type": "number", "minimum": 0 }, "speed_y": { "type": "number", "minimum": 0 },
        "ia_type": { "enum": ["walker", "chaser"] }, "ia_random": { "$ref": "#/$defs/booleanInteger" },
        "ia_randomness": { "$ref": "#/$defs/nonNegativeInteger" }, "ia_block_steps": { "$ref": "#/$defs/nonNegativeInteger" },
        "ia_orig_x": { "type": "integer" }, "ia_orig_y": { "type": "integer" },
        "ia_limit_x": { "$ref": "#/$defs/nonNegativeInteger" }, "ia_limit_y": { "$ref": "#/$defs/nonNegativeInteger" },
        "definition": { "$ref": "#/$defs/definitionReference" }
      }
    },
    "cameraViewArray": { "type": "array", "items": { "$ref": "#/$defs/cameraView" } },
    "cameraView": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "left_up_x", "left_up_y", "right_down_x", "right_down_y"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInteger" },
        "left_up_x": { "type": "integer" }, "left_up_y": { "type": "integer" },
        "right_down_x": { "type": "integer" }, "right_down_y": { "type": "integer" }
      }
    },
    "animationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "states"],
      "properties": {
        "kind": { "enum": ["object", "character"] },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "id", "animation"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "id": { "type": "integer", "minimum": 0 },
              "animation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bitmap", "frameDurationTicks", "sprites"],
                "properties": {
                  "bitmap": { "$ref": "#/$defs/nonEmptyString" },
                  "frameDurationTicks": { "type": "integer", "minimum": 1 },
                  "sprites": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["x", "y", "width", "height"],
                      "properties": {
                        "x": { "type": "integer", "minimum": 0 },
                        "y": { "type": "integer", "minimum": 0 },
                        "width": { "$ref": "#/$defs/positiveInteger" },
                        "height": { "$ref": "#/$defs/positiveInteger" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
