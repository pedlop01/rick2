{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rick2.example/schema/project.schema.json",
  "title": "Rick2 Engine portable project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "name", "initialLevel", "levels"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "rick2.project" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "initialLevel": { "$ref": "#/$defs/safeRelativeJsonPath" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeRelativeJsonPath" }
    }
  },
  "$defs": {
    "safeRelativeJsonPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^:]+\\.json$"
    }
  }
}
